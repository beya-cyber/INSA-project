# CORS (comma-separated origins allowed to call this API with credentials)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
CSRF_TRUSTED_ORIGINS=https://insa-ndsir.gov.et
FRONTEND_BASE_URL=http://localhost:5173

# Django Core
DJANGO_SECRET_KEY=change-this-to-a-random-64-char-secret-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=insa-ndsir.gov.et,localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=core_config.settings.production

# Database (PostgreSQL)
POSTGRES_DB=ndsir_db
POSTGRES_USER=ndsir_admin
POSTGRES_PASSWORD=change-this-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Account Lockout (brute-force protection)
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_LOCKOUT_MINUTES=15

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MIN=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=1

# Fayda National Digital ID
FAYDA_EKYC_BASE_URL=https://api.fayda.gov.et/v1
FAYDA_CLIENT_ID=your-fayda-client-id
FAYDA_CLIENT_SECRET=your-fayda-client-secret

# EthSwitch / Bank Backend Integration
ETHSWITCH_API_BASE_URL=https://switch.ethswitch.et/api/v1
ETHSWITCH_API_KEY=your-ethswitch-api-key
ETHSWITCH_HMAC_SECRET=your-hmac-shared-secret

# Telecom Integrations
ETHIO_TELECOM_API_BASE_URL=https://api.ethiotelecom.et/lawful-services/v1
ETHIO_TELECOM_API_KEY=your-ethio-telecom-key
SAFARICOM_ET_API_BASE_URL=https://api.safaricom.et/security/v1
SAFARICOM_ET_API_KEY=your-safaricom-key

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=your-telegram-webhook-secret

# Email / SMS Alerts
EMAIL_HOST=smtp.insa.gov.et
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@insa.gov.et
EMAIL_HOST_PASSWORD=change-me
SMS_GATEWAY_API_KEY=your-sms-gateway-key
SMS_GATEWAY_BASE_URL=https://api.your-sms-provider.et/v1
SMS_GATEWAY_SENDER_ID=NDSIR

# OCR Engine
OCR_ENGINE=tesseract   # options: tesseract | easyocr
TESSERACT_CMD=/usr/bin/tesseract

# Sentry / Monitoring (optional)
SENTRY_DSN=
